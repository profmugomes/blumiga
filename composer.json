{
    "name": "profmugomes/blumiga",
    "version": "1.0.0-alpha",
    "description": "Blumiga é um microframework MVC para PHP com arquitetura procedural, modular e de alta performance.",
    "keywords": ["php", "framework", "microframework", "mvc", "procedural", "functional", "modular", "lightweight", "composer", "blumiga"],
    "type": "project",
    "authors": [
        {
            "name": "Murilo Gomes Julio",
            "email": "profmugomes@gmail.com",
            "homepage": "https://www.profmugomes.com.br"
        }
    ],
    "_comment": [
        "Copyright (C) 2026 Murilo Gomes Julio"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "ext-mysqli": "*"
    },
    "suggest": {
        "ext-intl": "Necessário para formatCurrency(), dayOfWeek() e monthName()"
    },
    "autoload": {
        "psr-4": {
            "Blumiga\\": "libs/"
        },
        "files": [
            "core/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('config/config.php') || copy('config/config.example.php', 'config/config.php');\""
        ]
    }
}
