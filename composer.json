{
    "name": "profmugomes/blumiga",
    "version": "1.1.0-alpha",
    "description": "Blumiga é um microframework MVC procedural para PHP com suporte a MySQL/MariaDB via BlumigaDB.",
    "keywords": ["php", "framework", "microframework", "mvc", "procedural", "functional", "modular", "lightweight", "composer", "blumiga"],
    "type": "project",
    "authors": [
        {
            "name": "Murilo Gomes Julio",
            "email": "profmugomes@gmail.com",
            "homepage": "https://www.profmugomes.com.br"
        }
    ],
    "_comment": [
        "Copyright (C) 2026 Murilo Gomes Julio"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-zlib": "Necessário para compressão gzip (ob_gzhandler)",
        "ext-intl": "Necessário para formatCurrency(), dayOfWeek() e monthName()",
        "ext-mysqli": "Necessário para banco de dados (BlumigaDB)"
    },
    "autoload": {
        "psr-4": {
            "Blumiga\\": "libs/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('config/config.php') || copy('config/config.example.php', 'config/config.php');\""
        ],
        "test": "php tests/phpunit --bootstrap tests/bootstrap.php tests/",
        "test:security": "php tests/phpunit --bootstrap tests/bootstrap.php tests/Security/",
        "test:error": "php tests/phpunit --bootstrap tests/bootstrap.php tests/Error/",
        "test:unit": "php tests/phpunit --bootstrap tests/bootstrap.php tests/Unit/",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13"
    }
}
